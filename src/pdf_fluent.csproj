<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Version>0.6.0</Version>
        <Product>Fluent PDF</Product>
        <AssemblyTitle>Fluent PDF</AssemblyTitle>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
        <Authors>Yichen Zhao</Authors>
        <!-- ReadyToRun is only valid for RID-specific publishes. The release
             workflow passes -r win-x64; keep plain dotnet build unaffected.
             Pass -p:PublishReadyToRunComposite=false for smaller individual
             R2R images if composite R2R ever causes a compatibility issue. -->
        <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
        <PublishReadyToRunComposite Condition="'$(RuntimeIdentifier)' != '' and '$(SelfContained)' == 'true' and '$(PublishReadyToRun)' == 'true'">true</PublishReadyToRunComposite>
    </PropertyGroup>

    <ItemGroup>
        <Folder Include="Models\" />
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="pdf_fluent.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Optris.Icons.Avalonia" Version="12.0.7" />
        <PackageReference Include="Optris.Icons.Avalonia.FontAwesome" Version="12.0.7" />
        <PackageReference Include="PDFiumCore" Version="157.0.8100" />
    </ItemGroup>
</Project>
