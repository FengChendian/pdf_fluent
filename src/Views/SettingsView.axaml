<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:pdf_fluent.ViewModels"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             x:Class="pdf_fluent.Views.SettingsView"
             x:DataType="vm:MainViewModel"
             Background="#F8FAFE">
    <UserControl.Styles>
        <Style Selector="Button.update-action">
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DDD9F5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#625BE7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.update-action:pointerover">
            <Setter Property="Background" Value="#F3F1FF" />
            <Setter Property="BorderBrush" Value="#C9C3F2" />
        </Style>
        <Style Selector="Button.update-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F3F1FF" />
        </Style>
        <Style Selector="Button.update-action.available">
            <Setter Property="Background" Value="#6C5CE7" />
            <Setter Property="BorderBrush" Value="#6C5CE7" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.update-action.available:pointerover">
            <Setter Property="Background" Value="#5E50D7" />
            <Setter Property="BorderBrush" Value="#5E50D7" />
        </Style>
        <Style Selector="Button.update-action.available:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#5E50D7" />
        </Style>
        <Style Selector="Button.update-action:disabled">
            <Setter Property="Background" Value="#F6F5FC" />
            <Setter Property="Foreground" Value="#8C86C8" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Button.update-action:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F6F5FC" />
        </Style>
        <Style Selector="i|Icon.update-spinner">
            <Style.Animations>
                <Animation Duration="0:0:0.8" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="860" Margin="44,36,44,44" HorizontalAlignment="Center">
            <StackPanel Spacing="24">
                <StackPanel Spacing="8">
                    <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold" Foreground="#272A3C" />
                    <TextBlock Text="管理应用偏好，让 Fluent PDF 保持理想状态。"
                               FontSize="13" Foreground="#9297A8" />
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Text="应用" Margin="4,0,0,0" FontSize="12" FontWeight="SemiBold"
                               Foreground="#858B9E" />
                    <Border x:Name="UpdateSettingsCard" Height="104" Background="#FFFFFF" BorderBrush="#ECECF3"
                            BorderThickness="1" CornerRadius="16" Padding="24,22">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                            <Border Width="46" Height="46" CornerRadius="13" Background="#F0EEFF"
                                    VerticalAlignment="Center">
                                <i:Icon Value="fa-solid fa-arrow-rotate-right" FontSize="19"
                                        Foreground="#6C5CE7" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                                <TextBlock Text="应用更新" FontSize="15" FontWeight="SemiBold"
                                           Foreground="#303347" />
                                <TextBlock FontSize="11" Foreground="#969BAC" TextWrapping="Wrap">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="当前版本 {0} · 发现新版本时可前往 GitHub 下载">
                                            <Binding Path="Settings.CurrentVersionText" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="9" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="UpdateStatusText" Text="{Binding Settings.UpdateStatusMessage}"
                                           FontSize="11" Foreground="#8D93A5" HorizontalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="220" />
                                <Button x:Name="UpdateActionButton" Classes="update-action"
                                        Classes.available="{Binding Settings.HasAvailableUpdate}"
                                        Command="{Binding Settings.UpdateActionCommand}"
                                        HorizontalAlignment="Center"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <i:Icon x:Name="UpdateProgressRing" Classes="update-spinner"
                                                Value="fa-solid fa-circle-notch" FontSize="14"
                                                RenderTransformOrigin="50%,50%"
                                                IsVisible="{Binding Settings.IsCheckingUpdate}">
                                            <i:Icon.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </i:Icon.RenderTransform>
                                        </i:Icon>
                                        <TextBlock Text="{Binding Settings.UpdateButtonText}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="12" Margin="0,4,0,0">
                    <TextBlock Text="关于" Margin="4,0,0,0" FontSize="12" FontWeight="SemiBold"
                               Foreground="#858B9E" />
                    <Border x:Name="AboutSettingsCard" Height="104" Background="#FFFFFF"
                            BorderBrush="#ECECF3" BorderThickness="1" CornerRadius="16" Padding="24,22">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                            <Border Width="46" Height="46" CornerRadius="13" VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,100%" EndPoint="100%,0%">
                                        <GradientStop Color="#835EF6" Offset="0" />
                                        <GradientStop Color="#566BF5" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="P" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                                <TextBlock Text="Fluent PDF" FontSize="15" FontWeight="SemiBold"
                                           Foreground="#303347" />
                                <TextBlock Text="轻盈、专注的 PDF 阅读体验" FontSize="11"
                                           Foreground="#969BAC" />
                            </StackPanel>
                            <Border Grid.Column="2" Background="#F5F5FA" CornerRadius="9"
                                    Padding="10,5" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Settings.CurrentVersionText, StringFormat='v{0}'}"
                                           FontSize="11" FontWeight="Medium" Foreground="#7E8498" />
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
