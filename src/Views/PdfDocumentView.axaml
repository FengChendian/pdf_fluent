<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:pdf_fluent.ViewModels"
             xmlns:models="using:pdf_fluent.Models"
             xmlns:controls="using:pdf_fluent.Controls"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             x:Class="pdf_fluent.Views.PdfDocumentView"
             x:DataType="vm:DocumentTabViewModel">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://pdf_fluent/Themes/WorkspaceResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <!-- The reader header is a single 34-DIP row: page navigation, table of contents and
             every tool button share it, so the flyout tails sit the same distance below each
             anchor. Keep 34 here rather than reintroducing a second control height. -->
        <Style Selector="Button.tool-button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="#666D80" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.tool-button:pointerover">
            <Setter Property="Background" Value="#F0F2F8" />
        </Style>
        <Style Selector="Button.tool-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F0F2F8" />
        </Style>
        <Style Selector="Button.tool-button:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C4C8D2" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Button.tool-button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.tool-button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="#666D80" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.tool-button:pointerover">
            <Setter Property="Background" Value="#F0F2F8" />
        </Style>
        <Style Selector="ToggleButton.tool-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F0F2F8" />
        </Style>
        <Style Selector="ToggleButton.tool-button:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C4C8D2" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="ToggleButton.tool-button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.tool-button:checked">
            <Setter Property="Background" Value="#E8E3FF" />
            <Setter Property="Foreground" Value="#6C5CE7" />
        </Style>
        <Style Selector="ToggleButton.tool-button:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E8E3FF" />
        </Style>
        <Style Selector="ToggleButton.highlight-button:checked">
            <Setter Property="Background" Value="{Binding HighlightButtonBackground}" />
            <Setter Property="Foreground" Value="{Binding HighlightButtonForeground}" />
        </Style>
        <Style Selector="ToggleButton.highlight-button:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{Binding $parent[ToggleButton].Background}" />
            <Setter Property="Foreground" Value="{Binding $parent[ToggleButton].Foreground}" />
        </Style>
        <Style Selector="ToggleButton.highlight-button:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{Binding $parent[ToggleButton].Background}" />
            <Setter Property="Foreground" Value="{Binding $parent[ToggleButton].Foreground}" />
        </Style>
        <Style Selector="ToggleButton.highlight-button:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{Binding $parent[ToggleButton].Background}" />
            <Setter Property="Foreground" Value="{Binding $parent[ToggleButton].Foreground}" />
        </Style>
        <Style Selector="ToggleButton.page-jump-button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.page-jump-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F0F2F8" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ToggleButton.page-jump-button:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F0EDFF" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.page-jump-submit">
            <Setter Property="Background" Value="#6C5CE7" />
        </Style>
        <Style Selector="Button.page-jump-submit:pointerover">
            <Setter Property="Background" Value="#5B4BD5" />
        </Style>
        <Style Selector="Button.page-jump-submit:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#5B4BD5" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBox.page-jump-input:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#DDE2EC" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBox.page-jump-input:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#DDE2EC" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.page-surface">
            <Setter Property="BoxShadow" Value="0 4 22 0 #14000000" />
        </Style>
        <Style Selector="Border.reader-pill">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DDE2EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BoxShadow" Value="0 4 18 0 #14000000" />
        </Style>
        <Style Selector="Border.page-navigation">
            <Setter Property="Background" Value="{DynamicResource WorkspaceSurfaceBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <!-- Keep all three flyouts one DIP below the header: 41 + 8 - 48 = 1.
             Closed margins retain the same eight-DIP opening animation. -->
        <Style Selector="Grid.toc-flyout">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Margin" Value="0,33,0,20" />
        </Style>
        <Style Selector="Grid.toc-flyout.open">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Margin" Value="0,41,0,20" />
        </Style>
        <Style Selector="Grid.page-jump-flyout">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Margin" Value="0,33,16,0" />
        </Style>
        <Style Selector="Grid.page-jump-flyout.open">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Margin" Value="0,41,16,0" />
        </Style>
        <Style Selector="Grid.highlight-flyout">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Margin" Value="0,33,0,0" />
        </Style>
        <Style Selector="Grid.highlight-flyout.open">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Margin" Value="0,41,0,0" />
        </Style>
        <Style Selector="ToggleButton.toc-expander">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="#747B8D" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform">
                <RotateTransform Angle="0" />
            </Setter>
        </Style>
        <Style Selector="ToggleButton.toc-expander:checked">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#747B8D" />
            <Setter Property="RenderTransform">
                <RotateTransform Angle="90" />
            </Setter>
        </Style>
        <Style Selector="ToggleButton.toc-expander:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.toc-expander:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.toc-expander:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.toc-item">
            <Setter Property="Padding" Value="7,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Foreground" Value="#424758" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.toc-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F0F3F9" />
        </Style>
        <Style Selector="Button.highlight-swatch">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.highlight-swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F0F2F8" />
        </Style>
        <Style Selector="Button.highlight-swatch.selected">
            <Setter Property="BorderBrush" Value="#8B7ED8" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.highlight-swatch.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="#8B7ED8" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.highlight-swatch.custom-swatch">
            <Setter Property="Width" Value="64" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="#F7F8FB" />
            <Setter Property="BorderBrush" Value="#DDE2EC" />
        </Style>
        <Style Selector="Button.highlight-swatch.custom-swatch /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderBrush" Value="#DDE2EC" />
        </Style>
        <Style Selector="Button.highlight-swatch.custom-swatch.selected">
            <Setter Property="BorderBrush" Value="#8B7ED8" />
        </Style>
        <Style Selector="Button.highlight-swatch.custom-swatch.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="#8B7ED8" />
        </Style>
        <Style Selector="NumericUpDown.color-channel">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="BorderBrush" Value="#DDE2EC" />
            <Setter Property="ShowButtonSpinner" Value="False" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="255" />
            <Setter Property="FormatString" Value="0" />
            <Setter Property="AllowSpin" Value="True" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Background="{DynamicResource WorkspaceCanvasBrush}" ClipToBounds="True">
        <Border x:Name="ReaderHeader" MinHeight="48" Padding="16,4" Background="{DynamicResource WorkspaceSurfaceBrush}"
                BorderBrush="{DynamicResource WorkspaceBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
                <ToggleButton x:Name="TableOfContentsButton" Classes="tool-button"
                              Width="34" Height="34"
                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0"
                              CornerRadius="8"
                              IsVisible="{Binding IsLoaded}"
                              IsChecked="{Binding IsTableOfContentsOpen}"
                              ToolTip.Tip="目录">
                    <i:Icon Value="fa-solid fa-list-ul" FontSize="14"
                            Foreground="{Binding $parent[ToggleButton].Foreground}" />
                </ToggleButton>

                <Border x:Name="ReaderToolbar" Grid.Column="1" Padding="0"
                        Background="Transparent"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"
                        IsVisible="{Binding IsLoaded}">
                    <StackPanel Orientation="Horizontal" Spacing="5" Height="34">
                        <!-- This row must stay an even width. The header centres it between two
                             equal star columns, so an odd width gets rounded onto a half DIP and
                             the toolbar drifts 0.5 DIP off the page centre. The extra DIP sits on
                             the label group's left inset (3 instead of 2). -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="3,0,7,0">
                            <Border Background="#F0EDFF" CornerRadius="7" Padding="7,4">
                                <TextBlock Text="PDF" FontSize="10" FontWeight="Bold" Foreground="#6C5CE7" />
                            </Border>
                            <TextBlock Text="{Binding PageCount, StringFormat='{}{0} 页'}"
                                       FontSize="12" Foreground="#858B9A" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Width="1" Height="20" Background="#ECECF2" VerticalAlignment="Center" Margin="3,0" />

                        <Grid x:Name="ZoomControls" Width="132" Height="34" ColumnDefinitions="44,44,44" VerticalAlignment="Center">
                            <Button x:Name="ZoomOutButton" Classes="tool-button"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Click="OnZoomOutClick" ToolTip.Tip="缩小">
                                <i:Icon Value="fa-solid fa-minus" FontSize="11" Foreground="#666D80" />
                            </Button>
                            <TextBlock Grid.Column="1" Text="{Binding ZoomPercent, StringFormat='{}{0}%'}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="12" Foreground="#555C6E" />
                            <Button x:Name="ZoomInButton" Grid.Column="2" Classes="tool-button"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Click="OnZoomInClick" ToolTip.Tip="放大">
                                <i:Icon Value="fa-solid fa-plus" FontSize="11" Foreground="#666D80" />
                            </Button>
                        </Grid>

                        <Border Width="1" Height="20" Background="#ECECF2" VerticalAlignment="Center" Margin="3,0" />
                        <Button x:Name="SearchButton" Classes="tool-button" Click="OnSearchClick" ToolTip.Tip="文档内搜索（Ctrl+F）">
                            <i:Icon Value="fa-solid fa-magnifying-glass" FontSize="14"
                                    Foreground="{Binding $parent[Button].Foreground}" />
                        </Button>
                        <ToggleButton x:Name="HighlightButton" Classes="tool-button highlight-button"
                                      IsChecked="{Binding IsHighlightMode, Mode=OneWay}" Click="OnHighlightButtonClick"
                                      ToolTip.Tip="高亮颜色 · 拖动选择或单击单词；Esc 退出">
                            <Grid Width="20" Height="24">
                                <i:Icon x:Name="HighlightToolIcon" Value="fa-solid fa-highlighter" FontSize="14"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Foreground="{Binding $parent[ToggleButton].Foreground}" />
                                <Border x:Name="HighlightColorIndicator" Width="14" Height="2" CornerRadius="1"
                                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                        Background="{Binding HighlightColor}" />
                            </Grid>
                        </ToggleButton>
                        <Button x:Name="AnnotationButton" Classes="tool-button" IsEnabled="False" ToolTip.Tip="画笔批注（即将推出）">
                            <i:Icon Value="fa-solid fa-pen" FontSize="14"
                                    Foreground="{Binding $parent[Button].Foreground}" />
                        </Button>
                        <Button x:Name="DownloadButton" Classes="tool-button" IsEnabled="False" ToolTip.Tip="下载（即将推出）">
                            <i:Icon Value="fa-solid fa-download" FontSize="14"
                                    Foreground="{Binding $parent[Button].Foreground}" />
                        </Button>
                        <Button x:Name="MoreToolsButton" Classes="tool-button" ToolTip.Tip="更多文档工具">
                            <i:Icon Value="fa-solid fa-ellipsis" FontSize="15"
                                    Foreground="{Binding $parent[Button].Foreground}" />
                            <Button.Flyout>
                                <controls:UnselectedMenuFlyout Placement="BottomEdgeAlignedRight"
                                            FlyoutPresenterTheme="{StaticResource MoreActionsMenuPresenterTheme}"
                                            ItemContainerTheme="{StaticResource MoreActionsMenuItemTheme}">
                                    <MenuItem Click="OnFavoriteClick">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal" Spacing="9">
                                                <i:Icon x:Name="FavoriteMenuIcon" Value="fa-regular fa-star" FontSize="14"
                                                        Foreground="#6C6483" />
                                                <TextBlock Text="{Binding FavoriteToolTip}" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </controls:UnselectedMenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Border>

                <Border x:Name="PageNavigation" Classes="page-navigation" Padding="0" Height="34" Width="148" Grid.Column="2"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"
                        IsVisible="{Binding IsLoaded}">
                    <Grid ColumnDefinitions="34,*,34" ColumnSpacing="3">
                        <Button x:Name="PreviousPageButton" Classes="tool-button" Click="OnPreviousPageClick"
                                IsEnabled="{Binding CanGoToPreviousPage}" ToolTip.Tip="上一页">
                            <i:Icon Value="fa-solid fa-chevron-left" FontSize="11"
                                    Foreground="{Binding $parent[Button].Foreground}" />
                        </Button>
                        <ToggleButton x:Name="PageJumpButton" Grid.Column="1" Classes="page-jump-button"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                      IsCheckedChanged="OnPageJumpButtonToggled"
                                      AutomationProperties.Name="跳转到指定页" ToolTip.Tip="跳转到指定页">
                            <TextBlock x:Name="PageIndicatorText" Text="{Binding PageIndicator}" MinWidth="58"
                                       FontSize="12" Foreground="#656B7C" TextAlignment="Center"
                                       VerticalAlignment="Center" IsHitTestVisible="False" />
                        </ToggleButton>
                        <Button x:Name="NextPageButton" Grid.Column="2" Classes="tool-button" Click="OnNextPageClick"
                                IsEnabled="{Binding CanGoToNextPage}" ToolTip.Tip="下一页">
                            <i:Icon Value="fa-solid fa-chevron-right" FontSize="11"
                                    Foreground="{Binding $parent[Button].Foreground}" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="DocumentViewport" Grid.Row="1" Background="{DynamicResource WorkspaceCanvasBrush}" ClipToBounds="True">
            <ScrollViewer x:Name="DocumentScroller" Focusable="True"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PageItems" ItemsSource="{Binding Pages}"
                              ContainerPrepared="OnContainerPrepared"
                              LayoutUpdated="OnPagesLayoutUpdated">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:PdfVirtualizingPanel BufferFactor="1"
                                                           Padding="24,24,24,30"
                                                           Zoom="{Binding Zoom}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:PdfPageViewModel">
                            <Grid Width="{Binding ItemWidth}" Height="{Binding ItemHeight}"
                                  HorizontalAlignment="Center">
                                <Border x:Name="PageSurface" Width="{Binding PageWidth}" Height="{Binding PageHeight}"
                                        Classes="page-surface" VerticalAlignment="Top"
                                        Background="Transparent" CornerRadius="2">
                                    <Grid>
                                        <controls:PdfPageImage x:Name="PageBitmap" Page="{Binding}"
                                                               Document="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        <controls:PdfPageOverlay Page="{Binding}"
                                                                 PageImage="{Binding #PageBitmap}"
                                                                 Document="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                 IsHitTestVisible="False" />
                                        <ProgressBar Width="120" Height="4" IsIndeterminate="True"
                                                     Foreground="#6C5CE7" HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     IsVisible="{Binding IsPlaceholderVisible}" />
                                        <TextBlock Text="此页渲染失败" FontSize="13" Foreground="#B45D68"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   IsVisible="{Binding HasError}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Background="#EEF1F8" IsVisible="{Binding IsLoading}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                    <ProgressBar Width="180" Height="5" IsIndeterminate="True" Foreground="#6C5CE7" />
                    <TextBlock Text="正在读取页面信息…" FontSize="14" Foreground="#71778A" />
                </StackPanel>
            </Border>

            <Border Background="#EEF1F8" Padding="30"
                    IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="480">
                    <Border Width="58" Height="58" CornerRadius="18" Background="#FFECEF">
                        <TextBlock Text="!" FontSize="26" FontWeight="SemiBold" Foreground="#D86478"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="文档未能打开" FontSize="18" FontWeight="SemiBold" Foreground="#424758" />
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" TextAlignment="Center"
                               FontSize="12" Foreground="#858B9A" />
                    <Button Content="重试" Command="{Binding RetryCommand}" Padding="22,9"
                            CornerRadius="9" Background="#6C5CE7" Foreground="#FFFFFF" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="HighlightPaletteOverlay" Classes="highlight-flyout" Grid.RowSpan="2" Width="292"
              HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="False">
            <Grid.RenderTransform>
                <TranslateTransform />
            </Grid.RenderTransform>
            <Border x:Name="HighlightPalettePanel" Margin="0,8,0,0"
                    Background="White" BorderBrush="#DDE2EC" BorderThickness="1"
                    CornerRadius="12" BoxShadow="0 8 26 0 #1F26334A" />
            <Path x:Name="HighlightPalettePointerFill"
                  Data="M 0,8 C 4,8 4,0 10,0 C 16,0 16,8 20,8 L 20,12 L 0,12 Z"
                  Width="20" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Fill="White" IsHitTestVisible="False" />
            <Path x:Name="HighlightPalettePointer"
                  Data="M 0,8 C 4,8 4,0 10,0 C 16,0 16,8 20,8"
                  Width="20" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Stroke="#DDE2EC" StrokeThickness="1" IsHitTestVisible="False" />
            <StackPanel Margin="16,23,16,15" Spacing="12">
                <StackPanel x:Name="HighlightSwatches" Orientation="Horizontal" Spacing="7">
                    <Button x:Name="HighlightRedSwatch" Classes="highlight-swatch" Tag="{x:Static models:HighlightPalette.Red}"
                            Click="OnHighlightSwatchClick" ToolTip.Tip="柔玫红" AutomationProperties.Name="柔玫红">
                        <Border CornerRadius="12">
                            <Border.Background>
                                <SolidColorBrush Color="{x:Static models:HighlightPalette.Red}" />
                            </Border.Background>
                        </Border>
                    </Button>
                    <Button x:Name="HighlightOrangeSwatch" Classes="highlight-swatch" Tag="{x:Static models:HighlightPalette.Orange}"
                            Click="OnHighlightSwatchClick" ToolTip.Tip="杏橙" AutomationProperties.Name="杏橙">
                        <Border CornerRadius="12">
                            <Border.Background>
                                <SolidColorBrush Color="{x:Static models:HighlightPalette.Orange}" />
                            </Border.Background>
                        </Border>
                    </Button>
                    <Button x:Name="HighlightYellowSwatch" Classes="highlight-swatch" Tag="{x:Static models:HighlightPalette.Yellow}"
                            Click="OnHighlightSwatchClick" ToolTip.Tip="暖黄" AutomationProperties.Name="暖黄">
                        <Border CornerRadius="12">
                            <Border.Background>
                                <SolidColorBrush Color="{x:Static models:HighlightPalette.Yellow}" />
                            </Border.Background>
                        </Border>
                    </Button>
                    <Button x:Name="HighlightGreenSwatch" Classes="highlight-swatch" Tag="{x:Static models:HighlightPalette.Green}"
                            Click="OnHighlightSwatchClick" ToolTip.Tip="鼠尾草绿" AutomationProperties.Name="鼠尾草绿">
                        <Border CornerRadius="12">
                            <Border.Background>
                                <SolidColorBrush Color="{x:Static models:HighlightPalette.Green}" />
                            </Border.Background>
                        </Border>
                    </Button>
                    <Button x:Name="HighlightBlueSwatch" Classes="highlight-swatch" Tag="{x:Static models:HighlightPalette.Blue}"
                            Click="OnHighlightSwatchClick" ToolTip.Tip="雾蓝" AutomationProperties.Name="雾蓝">
                        <Border CornerRadius="12">
                            <Border.Background>
                                <SolidColorBrush Color="{x:Static models:HighlightPalette.Blue}" />
                            </Border.Background>
                        </Border>
                    </Button>
                    <Button x:Name="HighlightCustomSwatch" Classes="highlight-swatch custom-swatch"
                            Click="OnHighlightCustomClick" ToolTip.Tip="自定义颜色" AutomationProperties.Name="自定义颜色">
                        <Grid ColumnDefinitions="22,*,22" Background="Transparent">
                            <Border Width="20" Height="20" CornerRadius="10" Background="White"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border x:Name="HighlightCustomSwatchPreview" CornerRadius="10" />
                            </Border>
                            <Border Grid.Column="1" Width="1" Height="14" Background="#DDE2EC"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="HighlightCustomSwatchRainbow" Grid.Column="2"
                                    Width="20" Height="20" CornerRadius="10"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Background>
                                    <ConicGradientBrush Center="50%,50%">
                                        <GradientStop Color="#FFFF0000" Offset="0" />
                                        <GradientStop Color="#FFFFFF00" Offset="0.166667" />
                                        <GradientStop Color="#FF00FF00" Offset="0.333333" />
                                        <GradientStop Color="#FF00FFFF" Offset="0.5" />
                                        <GradientStop Color="#FF0000FF" Offset="0.666667" />
                                        <GradientStop Color="#FFFF00FF" Offset="0.833333" />
                                        <GradientStop Color="#FFFF0000" Offset="1" />
                                    </ConicGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>
                <StackPanel x:Name="HighlightCustomPanel" Spacing="12" IsVisible="False">
                    <Border Height="1" Background="#ECECF2" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="自定义颜色" FontSize="12" FontWeight="SemiBold" Foreground="#424758" />
                        <Button x:Name="HighlightCustomCollapseButton" Grid.Column="1" Classes="tool-button" Width="20" Height="20"
                                Click="OnHighlightCustomCloseClick" ToolTip.Tip="收起自定义颜色" AutomationProperties.Name="收起自定义颜色">
                            <i:Icon Value="fa-solid fa-chevron-up" FontSize="10" />
                        </Button>
                    </Grid>
                    <controls:HighlightColorSpectrum x:Name="HighlightSpectrum" Height="146"
                        AutomationProperties.Name="颜色色域，方向键调整饱和度和明度，PageUp 和 PageDown 调整色相" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="R" FontSize="10" Foreground="#858B9A" />
                            <NumericUpDown x:Name="HighlightRedInput" Classes="color-channel"
                                           ValueChanged="OnHighlightRgbChanged" AutomationProperties.Name="红色通道" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="G" FontSize="10" Foreground="#858B9A" />
                            <NumericUpDown x:Name="HighlightGreenInput" Classes="color-channel"
                                           ValueChanged="OnHighlightRgbChanged" AutomationProperties.Name="绿色通道" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="B" FontSize="10" Foreground="#858B9A" />
                            <NumericUpDown x:Name="HighlightBlueInput" Classes="color-channel"
                                           ValueChanged="OnHighlightRgbChanged" AutomationProperties.Name="蓝色通道" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,32" ColumnSpacing="8">
                        <TextBlock Text="ARGB" FontSize="10" Foreground="#858B9A" VerticalAlignment="Center" />
                        <TextBox x:Name="HighlightArgbInput" Grid.Column="1" Classes="page-jump-input"
                                 Height="32" MinHeight="0" Padding="8,5" CornerRadius="7" FontSize="12"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#DDE2EC" Background="White" MaxLength="9"
                                 TextChanged="OnHighlightArgbChanged" AutomationProperties.Name="ARGB 颜色值"
                                 PlaceholderText="#AARRGGBB" />
                        <Border Grid.Column="2" CornerRadius="7" BorderBrush="#DDE2EC" BorderThickness="1" Background="#F2F3F7">
                            <Border x:Name="HighlightCustomPreview" CornerRadius="6">
                                <TextBlock Text="Aa" FontSize="11" Foreground="#424758" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="HighlightArgbError" Text="请输入 8 位 ARGB，例如 #60FFEB3B"
                               FontSize="10" Foreground="#B45D68" IsVisible="False" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid x:Name="PageJumpOverlay" Classes="page-jump-flyout" Grid.RowSpan="2" Width="{Binding #PageNavigation.Bounds.Width}"
              HorizontalAlignment="Right" VerticalAlignment="Top"
              IsVisible="False">
            <Border x:Name="PageJumpPanel" Margin="0,8,0,0"
                    Background="#FFFFFF" BorderBrush="#DDE2EC" BorderThickness="1"
                    CornerRadius="12" BoxShadow="0 8 26 0 #1F26334A" />
            <Path x:Name="PageJumpPointerFill"
                  Data="M 0,8 C 4,8 4,0 10,0 C 16,0 16,8 20,8 L 20,12 L 0,12 Z"
                  Width="20" Height="12"
                  HorizontalAlignment="Center" VerticalAlignment="Top"
                  Fill="#FFFFFF" IsHitTestVisible="False" />
            <Path x:Name="PageJumpPointer"
                  Data="M 0,8 C 4,8 4,0 10,0 C 16,0 16,8 20,8"
                  Width="20" Height="12"
                  HorizontalAlignment="Center" VerticalAlignment="Top"
                  Stroke="#DDE2EC" StrokeThickness="1" IsHitTestVisible="False" />
            <Border Margin="0,8,0,0" CornerRadius="12" ClipToBounds="True">
                <Grid RowDefinitions="Auto,Auto" Margin="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="PageJumpTextBox" Classes="page-jump-input" MinWidth="0" Height="34" Padding="10,6"
                                 FontSize="12" CornerRadius="8" VerticalContentAlignment="Center"
                                 Background="#FFFFFF" BorderBrush="#DDE2EC" BorderThickness="1"
                                 SelectionBrush="#DCEBFF" SelectionForegroundBrush="#365E91"
                                 TextAlignment="Center" PlaceholderText="页码" AutomationProperties.Name="目标页码"
                                 TextChanged="OnPageJumpTextChanged" KeyDown="OnPageJumpTextBoxKeyDown" />
                        <Button x:Name="GoToPageButton" Classes="page-jump-submit" Grid.Column="1" Content="跳转"
                                Height="34" Padding="12,0" FontSize="12" CornerRadius="8"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                VerticalAlignment="Center" Foreground="#FFFFFF"
                                Cursor="Hand" Click="OnGoToPageClick" />
                    </Grid>
                    <TextBlock x:Name="PageJumpError" Grid.Row="1" FontSize="11" Margin="0,8,0,0"
                               Foreground="#B45D68" TextWrapping="Wrap" IsVisible="False" />
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="TableOfContentsOverlay" Classes="toc-flyout"
              Grid.RowSpan="2" Width="330" MaxWidth="360"
              HorizontalAlignment="Left" VerticalAlignment="Stretch"
              IsVisible="False">
            <Border x:Name="TableOfContentsPanel" Margin="0,8,0,0"
                    Background="#FFFFFF" BorderBrush="#DDE2EC" BorderThickness="1"
                    CornerRadius="12" BoxShadow="0 8 26 0 #1F26334A" />
            <Path x:Name="TableOfContentsPointerFill"
                  Data="M 0,8 C 4,8 4,0 10,0 C 16,0 16,8 20,8 L 20,12 L 0,12 Z"
                  Width="20" Height="12" Margin="23,0,0,0"
                  HorizontalAlignment="Left" VerticalAlignment="Top"
                  Fill="#FFFFFF" IsHitTestVisible="False" />
            <Path x:Name="TableOfContentsPointer"
                  Data="M 0,8 C 4,8 4,0 10,0 C 16,0 16,8 20,8"
                  Width="20" Height="12" Margin="23,0,0,0"
                  HorizontalAlignment="Left" VerticalAlignment="Top"
                  Stroke="#DDE2EC" StrokeThickness="1" IsHitTestVisible="False" />
            <Border Margin="0,8,0,0" CornerRadius="12" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                    <Border Padding="16,13,16,10" BorderBrush="#ECECF2" BorderThickness="0,0,0,1">
                        <TextBlock Text="目录" FontSize="13" FontWeight="SemiBold" Foreground="#424758" />
                    </Border>
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="TocItems" ItemsSource="{Binding VisibleTocEntries}" Padding="8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:TocEntryViewModel">
                                    <Grid ColumnDefinitions="28,*" Margin="{Binding Indent}">
                                        <ToggleButton x:Name="TocExpanderButton" Classes="toc-expander"
                                                      IsChecked="{Binding IsExpanded}"
                                                      IsVisible="{Binding HasChildren}"
                                                      ToolTip.Tip="展开或收起子目录">
                                            <Path Data="M 2,0 L 8,5 L 2,10 Z" Width="8" Height="10"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Fill="{Binding $parent[ToggleButton].Foreground}" />
                                        </ToggleButton>
                                        <Button x:Name="TocNavigateButton" Grid.Column="1" Classes="toc-item"
                                                Click="OnTocItemClick" IsEnabled="{Binding CanNavigate}">
                                            <TextBlock Text="{Binding Title}" FontSize="12" LineHeight="18"
                                                       TextWrapping="Wrap" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="LinkStatus" Grid.RowSpan="2" Background="#F2FFFFFF" BorderBrush="#DDE2EC" BorderThickness="1"
                CornerRadius="8" Padding="10,6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16"
                MaxWidth="520" IsVisible="False" IsHitTestVisible="False">
            <TextBlock x:Name="LinkStatusText" FontSize="11" Foreground="#51596D" TextTrimming="CharacterEllipsis" />
        </Border>

        <Border x:Name="PageIndicatorOverlay" Grid.RowSpan="2" Background="#F2FFFFFF" BorderBrush="#DDE2EC" BorderThickness="1"
                CornerRadius="16" Padding="16,8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20"
                BoxShadow="0 3 14 0 #12000000" IsVisible="False" IsHitTestVisible="False">
            <TextBlock Text="{Binding FloatingPageIndicator}" FontSize="11" Foreground="#8A8F9E" />
        </Border>

        <Border x:Name="SearchPanel" Classes="reader-pill" Grid.RowSpan="2" Width="320" MaxHeight="480"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,56,20,0"
                Padding="12,8,12,12" IsVisible="{Binding IsSearchPanelVisible}">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="SearchPanelTitle" Text="文档内搜索" FontSize="14" FontWeight="SemiBold"
                               Foreground="#424758" VerticalAlignment="Center" />
                    <Button x:Name="CloseSearchButton" Grid.Column="1" Classes="tool-button"
                            Width="26" Height="26" Click="OnCloseSearchClick" ToolTip.Tip="关闭搜索">
                        <i:Icon Value="fa-solid fa-xmark" FontSize="12"
                                Foreground="{Binding $parent[Button].Foreground}" />
                    </Button>
                </Grid>
                <TextBox x:Name="SearchTextBox" Grid.Row="1" Text="{Binding SearchQuery}"
                         PlaceholderText="输入关键词…" CornerRadius="8" MinHeight="34" Margin="0,14,0,0" />
                <Grid Grid.Row="2" RowDefinitions="Auto,*" Margin="0,10,0,0">
                    <TextBlock x:Name="SearchStatusText" Text="{Binding SearchStatus}" FontSize="11" Foreground="#858B9A" />
                    <ListBox x:Name="SearchResultsList" Grid.Row="1" ItemsSource="{Binding SearchResults}"
                             SelectionChanged="OnSearchResultSelected" BorderThickness="0" Background="Transparent"
                             IsVisible="{Binding !!SearchResults.Count}" Margin="0,6,0,0" MaxHeight="340">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="3" Margin="2,4">
                                    <TextBlock Text="{Binding PageLabel}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#6C5CE7" />
                                    <TextBlock Text="{Binding Context}" FontSize="12" Foreground="#51596D"
                                               TextWrapping="Wrap" MaxWidth="270" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
                <TextBlock Grid.Row="3" Text="{Binding HighlightErrorMessage}" TextWrapping="Wrap"
                           FontSize="11" Foreground="#B45D68" Margin="0,10,0,0"
                           IsVisible="{Binding HighlightErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
