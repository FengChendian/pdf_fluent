<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:pdf_fluent.ViewModels"
             xmlns:controls="using:pdf_fluent.Controls"
             x:Class="pdf_fluent.Views.PdfDocumentView"
             x:DataType="vm:DocumentTabViewModel">
    <UserControl.Styles>
        <Style Selector="Button.tool-button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="#666D80" />
        </Style>
        <Style Selector="Button.tool-button:pointerover">
            <Setter Property="Background" Value="#E9ECF2" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="54,*" Background="#EEF0F3">
        <Border Background="#FFFFFF" BorderBrush="#E6E8ED" BorderThickness="0,0,0,1" Padding="18,0">
            <Grid ColumnDefinitions="*,Auto,*">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="#F0F1FF" CornerRadius="8" Padding="7,4">
                        <TextBlock Text="PDF" FontSize="10" FontWeight="Bold" Foreground="#6D78D7" />
                    </Border>
                    <TextBlock Text="{Binding PageCount, StringFormat='{}{0} 页'}"
                               FontSize="12" Foreground="#858B9A" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Classes="tool-button" Content="−" FontSize="19"
                            Command="{Binding ZoomOutCommand}" ToolTip.Tip="缩小" />
                    <Border MinWidth="60" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ZoomPercent, StringFormat='{}{0}%'}"
                                   HorizontalAlignment="Center" FontSize="12" Foreground="#555C6E" />
                    </Border>
                    <Button Classes="tool-button" Content="+" FontSize="17"
                            Command="{Binding ZoomInCommand}" ToolTip.Tip="放大" />
                    <Border Width="1" Height="20" Background="#E4E6EB" Margin="10,0" />
                    <PathIcon Width="16" Height="16" Foreground="#7A8191" Margin="6,0"
                              Data="M4,3 L10,3 L10,5 L6,5 L6,19 L18,19 L18,5 L14,5 L14,3 L20,3 L20,21 L4,21 Z" />
                    <TextBlock Text="连续滚动" FontSize="12" Foreground="#858B9A" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="按需渲染" FontSize="11" Foreground="#9AA0AE"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           IsVisible="{Binding IsLoaded}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Pages}" Margin="24,8,24,30"
                              ContainerPrepared="OnContainerPrepared"
                              ContainerClearing="OnContainerClearing">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:PdfVirtualizingPanel BufferFactor="1"
                                                           LayoutVersion="{Binding LayoutVersion}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:PdfPageViewModel">
                            <StackPanel Width="{Binding ItemWidth}" Height="{Binding ItemHeight}"
                                        HorizontalAlignment="Center" Spacing="7">
                                <Border Width="{Binding PageWidth}" Height="{Binding PageHeight}"
                                        Background="#FFFFFF" CornerRadius="2" ClipToBounds="True"
                                        BoxShadow="0 3 18 0 #18000000">
                                    <Grid>
                                        <Image Source="{Binding Image}" Stretch="Uniform" />
                                        <ProgressBar Width="120" Height="4" IsIndeterminate="True"
                                                     Foreground="#7180E5" HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     IsVisible="{Binding IsLoading}" />
                                        <TextBlock Text="此页渲染失败" FontSize="13" Foreground="#B45D68"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   IsVisible="{Binding HasError}" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding PageNumber}" Height="14" FontSize="11"
                                           Foreground="#969BA7" HorizontalAlignment="Center"
                                           Margin="0,0,0,12" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Background="#EEF0F3" IsVisible="{Binding IsLoading}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                    <ProgressBar Width="180" Height="5" IsIndeterminate="True" Foreground="#7180E5" />
                    <TextBlock Text="正在读取页面信息…" FontSize="14" Foreground="#71778A" />
                    <TextBlock Text="页面将在滚动时按需渲染" FontSize="11" Foreground="#A0A5B1" />
                </StackPanel>
            </Border>

            <Border Background="#EEF0F3" Padding="30"
                    IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="480">
                    <Border Width="58" Height="58" CornerRadius="18" Background="#FFECEF">
                        <TextBlock Text="!" FontSize="26" FontWeight="SemiBold" Foreground="#D86478"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="文档未能打开" FontSize="18" FontWeight="SemiBold" Foreground="#424758" />
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" TextAlignment="Center"
                               FontSize="12" Foreground="#858B9A" />
                    <Button Content="重试" Command="{Binding RetryCommand}" Padding="22,9"
                            CornerRadius="9" Background="#6878DF" Foreground="#FFFFFF" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
