<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:pdf_fluent.ViewModels"
             x:Class="pdf_fluent.Views.HomeView"
             x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <Style Selector="Button.plain-button">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.plain-button:pointerover">
            <Setter Property="Background" Value="#F0F3F9" />
        </Style>
        <Style Selector="Button.quick-card">
            <Setter Property="Width" Value="280" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#E3E7F3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter x:Name="QuickCardContent"
                                      Content="{TemplateBinding Content}"
                                      Background="Transparent" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.quick-card:pointerover">
            <Setter Property="BorderBrush" Value="#7484E3" />
        </Style>
        <Style Selector="Button.recent-card">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#E8EBF2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,22,24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter x:Name="RecentCardContent"
                                      Content="{TemplateBinding Content}"
                                      Background="Transparent" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.recent-card:pointerover">
            <Setter Property="BorderBrush" Value="#8290E4" />
        </Style>
        <Style Selector="ContextMenu.recent-context-menu">
            <Setter Property="MinWidth" Value="172" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E4E7EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="MenuItem.danger-menu-item">
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="#CF5A6C" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="MenuItem.danger-menu-item:pointerover">
            <Setter Property="Background" Value="#FFF0F3" />
            <Setter Property="Foreground" Value="#BD4055" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="38,30,38,36" Spacing="26">
            <Border CornerRadius="24" Padding="30,26" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#EEF1FF" Offset="0" />
                        <GradientStop Color="#F4F7FF" Offset="0.55" />
                        <GradientStop Color="#EAF8F6" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="8">
                        <TextBlock Text="让阅读，回归专注"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="#20243A" />
                        <TextBlock Text="打开 PDF，即刻进入清爽、流畅的阅读空间。"
                                   FontSize="14"
                                   Foreground="#71778D" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Width="74" Height="74"
                            CornerRadius="22"
                            Background="#FFFFFF"
                            VerticalAlignment="Center">
                        <PathIcon Width="34" Height="34"
                                  Foreground="#6675E8"
                                  Data="M7,2 L15,2 L21,8 L21,24 L7,24 Z M15,2 L15,9 L21,9 M10,14 L18,14 M10,18 L18,18" />
                    </Border>
                </Grid>
            </Border>

            <StackPanel Spacing="16">
                <TextBlock Text="快捷入口" FontSize="20" FontWeight="SemiBold" Foreground="#25293B" />
                <Grid ColumnDefinitions="280,280,280" ColumnSpacing="16" HorizontalAlignment="Left">
                    <Button Classes="quick-card" Command="{Binding OpenPdfCommand}">
                        <Border Classes="quick-card-surface" Background="#FFFFFF" BorderBrush="{Binding $parent[Button].BorderBrush}" BorderThickness="1"
                                CornerRadius="20" Padding="22" Height="142">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
                                <Border Width="52" Height="52" CornerRadius="16" Background="#EEF0FF"
                                        VerticalAlignment="Center">
                                    <PathIcon Width="25" Height="25" Foreground="#6675E8"
                                              Data="M12,3 L12,17 M7,8 L12,3 L17,8 M5,14 L5,21 L19,21 L19,14" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                    <TextBlock Text="打开 PDF" FontSize="18" FontWeight="SemiBold" Foreground="#292D40" />
                                    <TextBlock Text="从电脑中选择文档" FontSize="12" Foreground="#9095A7" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>

                    <Button Grid.Column="1" Classes="quick-card" IsEnabled="False" Opacity="0.72">
                        <Border Classes="quick-card-surface" Background="#FFFFFF" BorderBrush="{Binding $parent[Button].BorderBrush}" BorderThickness="1"
                                CornerRadius="20" Padding="22" Height="142">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
                                <Border Width="52" Height="52" CornerRadius="16" Background="#EAF7F4"
                                        VerticalAlignment="Center">
                                    <PathIcon Width="25" Height="25" Foreground="#42A28D"
                                              Data="M5,3 L5,17 L13,17 M11,7 L11,21 L19,21 L19,7 Z M15,3 L19,7" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                    <TextBlock Text="合并 PDF" FontSize="18" FontWeight="SemiBold" Foreground="#292D40" />
                                    <TextBlock Text="即将推出" FontSize="12" Foreground="#9095A7" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>

                    <Border Grid.Column="2" Classes="quick-card-surface" Width="280"
                            Background="#FFFFFF" BorderBrush="#E3E7F3" BorderThickness="1"
                            CornerRadius="20" Padding="22" Height="142" Opacity="0.72">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
                            <Border Width="52" Height="52" CornerRadius="16" Background="#FFF4E8"
                                    VerticalAlignment="Center">
                                <PathIcon Width="25" Height="25" Foreground="#D79445"
                                          Data="M4,5 L10,5 L10,11 L4,11 Z M14,5 L20,5 L20,11 L14,11 Z M4,15 L10,15 L10,21 L4,21 Z M14,15 L20,15 L20,21 L14,21 Z" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                <TextBlock Text="更多工具" FontSize="18" FontWeight="SemiBold" Foreground="#292D40" />
                                <TextBlock Text="敬请期待" FontSize="12" Foreground="#9095A7" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="16" Margin="0,8,0,0">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="最近阅读" FontSize="20" FontWeight="SemiBold" Foreground="#25293B" />
                        <Border Background="#EEF0F7" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RecentDocuments.Count}" FontSize="11" Foreground="#747A90" />
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="网格模式" FontSize="12" Foreground="#9A9EAE"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Grid.Column="2" Classes="plain-button" Command="{Binding ClearRecentDocumentsCommand}"
                            BorderThickness="0" Padding="8,5" Cursor="Hand">
                        <TextBlock Text="清除所有记录" FontSize="12" Foreground="#81869A" />
                    </Button>
                </Grid>

                <ItemsControl ItemsSource="{Binding RecentDocuments}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:RecentDocumentViewModel">
                            <Button Classes="recent-card" Width="164" x:CompileBindings="False"
                                    Command="{Binding $parent[Window].DataContext.OpenRecentCommand}"
                                    CommandParameter="{Binding}">
                                <Button.ContextMenu>
                                    <ContextMenu Classes="recent-context-menu">
                                        <MenuItem Classes="danger-menu-item"
                                                  Command="{Binding RemoveCommand}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Header>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Path Width="15" Height="15" Stretch="Uniform"
                                                          Stroke="#CF5A6C" StrokeThickness="1.6"
                                                          Data="M3,5 L21,5 M9,5 L9,2 L15,2 L15,5 M6,5 L7,22 L17,22 L18,5 M10,9 L10,17 M14,9 L14,17" />
                                                    <TextBlock Text="删除此记录" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel Spacing="10">
                                    <Border Classes="card-surface" Width="164" Height="194"
                                            Background="#FFFFFF" BorderBrush="{Binding $parent[Button].BorderBrush}" BorderThickness="1"
                                            CornerRadius="14" Padding="10">
                                        <Grid>
                                            <Border Background="#F1F2F6" CornerRadius="9" Padding="20"
                                                    IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}">
                                                <StackPanel VerticalAlignment="Center" Spacing="10">
                                                    <PathIcon Width="38" Height="38" Foreground="#8C96C9"
                                                              HorizontalAlignment="Center"
                                                              Data="M6,2 L15,2 L21,8 L21,24 L6,24 Z M15,2 L15,9 L21,9" />
                                                    <TextBlock Text="PDF" FontSize="13" FontWeight="Bold"
                                                               Foreground="#8C96C9" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Spacing="4" Width="164">
                                        <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="Medium"
                                                   Foreground="#3B4052" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock Text="{Binding PageCountText}" FontSize="11" Foreground="#9A9EAE" />
                                            <TextBlock Text="·" FontSize="11" Foreground="#B5B8C4" />
                                            <TextBlock Text="{Binding LastOpenedText}" FontSize="11" Foreground="#9A9EAE" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="#F7F8FC" CornerRadius="18" Padding="28"
                        IsVisible="{Binding HasNoRecentDocuments}">
                    <TextBlock Text="还没有最近阅读记录，打开一个 PDF 开始吧。"
                               Foreground="#9297A8" HorizontalAlignment="Center" />
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
