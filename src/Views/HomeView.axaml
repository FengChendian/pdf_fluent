<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:pdf_fluent.ViewModels"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             x:Class="pdf_fluent.Views.HomeView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource WorkspaceSurfaceBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://pdf_fluent/Themes/WorkspaceResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="DocumentCardTemplate" DataType="vm:RecentDocumentViewModel">
            <Button Classes="recent-card" Width="196" x:CompileBindings="False"
                    Command="{Binding $parent[Window].DataContext.OpenRecentCommand}"
                    CommandParameter="{Binding}">
                <Button.ContextMenu>
                    <ContextMenu Classes="recent-context-menu" Opened="OnRecentContextMenuOpened"
                                 GotFocus="OnRecentContextMenuGotFocus">
                        <MenuItem Classes="danger-menu-item" Header="{Binding RemoveActionText}"
                                  Command="{Binding RemoveCommand}" CommandParameter="{Binding}" />
                    </ContextMenu>
                </Button.ContextMenu>
                <Border Width="196" Background="#FFFFFF"
                        BorderBrush="{Binding $parent[Button].BorderBrush}" BorderThickness="1"
                        CornerRadius="15" Padding="8">
                    <StackPanel Spacing="10">
                        <Border Height="142" Background="#F0EFF8" CornerRadius="10" ClipToBounds="True" Padding="10">
                            <Grid>
                                <Border IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}">
                                    <StackPanel VerticalAlignment="Center" Spacing="8">
                                        <i:Icon Value="fa-regular fa-file-pdf" FontSize="32" Foreground="#9993C8"
                                                HorizontalAlignment="Center" />
                                        <TextBlock Text="PDF" FontSize="11" FontWeight="Bold"
                                                   Foreground="#9993C8" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                            </Grid>
                        </Border>
                        <StackPanel Spacing="5" Margin="2,0,2,3">
                            <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="Medium"
                                       Foreground="#303347" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding PageCountText}" FontSize="11" Foreground="#969BAC" />
                                <TextBlock Text="·" FontSize="11" Foreground="#B9BCC7" />
                                <TextBlock Text="{Binding LastOpenedText}" FontSize="11" Foreground="#969BAC" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Button.plain-button">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.plain-button:pointerover">
            <Setter Property="Background" Value="#F0F3F9" />
        </Style>
        <Style Selector="Button.quick-card">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#EDEEF4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      Background="Transparent" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.quick-card:pointerover">
            <Setter Property="BorderBrush" Value="#C9C5F4" />
        </Style>
        <Style Selector="Button.recent-card">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#ECECF3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,18,22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      Background="Transparent" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.recent-card:pointerover">
            <Setter Property="BorderBrush" Value="#C9C5F4" />
        </Style>
        <Style Selector="ContextMenu.recent-context-menu">
            <Setter Property="MinWidth" Value="172" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E4E7EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="MenuItem.danger-menu-item">
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="#CF5A6C" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="MenuItem.danger-menu-item:pointerover">
            <Setter Property="Background" Value="#FFF0F3" />
            <Setter Property="Foreground" Value="#BD4055" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="36,28,36,36">
            <StackPanel Spacing="28" IsVisible="{Binding IsHomeSelected}">
                <Border CornerRadius="22" Padding="32,26" ClipToBounds="True" MinHeight="152">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#F1F0FF" Offset="0" />
                            <GradientStop Color="#F7F5FF" Offset="0.58" />
                            <GradientStop Color="#F0F8FC" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="12" VerticalAlignment="Center">
                            <TextBlock Text="让阅读，回归专注" FontSize="28" FontWeight="SemiBold" Foreground="#22243A" />
                            <TextBlock Text="打开 PDF，即刻进入清爽、流畅的阅读空间。"
                                       FontSize="13" Foreground="#85869B" />
                        </StackPanel>
                        <Grid Grid.Column="1" Width="230" Height="112" Margin="24,0,14,0">
                            <Ellipse Width="190" Height="100" Fill="#19A99CF4"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border Width="126" Height="92" CornerRadius="14" Background="#DCD8FF"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="38,0,0,0">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="-12" />
                                </Border.RenderTransform>
                            </Border>
                            <Border Width="126" Height="96" CornerRadius="14" Background="#FFFFFF"
                                    Padding="16,14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="0,0,42,0" BoxShadow="0 8 24 0 #16A79CF4">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Border Width="28" Height="34" CornerRadius="6" Background="#EFEDFF" VerticalAlignment="Top">
                                        <TextBlock Text="PDF" FontSize="8" FontWeight="Bold" Foreground="#6C5CE7"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="8" Margin="0,3,0,0">
                                        <Border Height="6" CornerRadius="3" Background="#ECECF5" />
                                        <Border Height="6" CornerRadius="3" Background="#F0F0F6" />
                                        <Border Height="6" CornerRadius="3" Background="#F0F0F6" Margin="0,5,0,0" />
                                        <Border Height="6" CornerRadius="3" Background="#F0F0F6" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel Spacing="16">
                    <TextBlock Text="快捷入口" FontSize="18" FontWeight="SemiBold" Foreground="#272A3C" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                        <Button Classes="quick-card" Command="{Binding OpenPdfCommand}">
                            <Border Background="#FFFFFF" BorderBrush="{Binding $parent[Button].BorderBrush}" BorderThickness="1"
                                    CornerRadius="16" Padding="22" Height="90">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                    <Border Width="48" Height="48" CornerRadius="14" Background="#EFEDFF" VerticalAlignment="Center">
                                        <i:Icon Value="fa-solid fa-file-arrow-up" FontSize="20" Foreground="#6C5CE7" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="7">
                                        <TextBlock Text="打开 PDF" FontSize="16" FontWeight="SemiBold" Foreground="#303347" />
                                        <TextBlock Text="从电脑中选择文档" FontSize="11" Foreground="#969BAC" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>

                        <Button Grid.Column="1" Classes="quick-card" IsEnabled="False" Opacity="0.76">
                            <Border Background="#FFFFFF" BorderBrush="#EDEEF4" BorderThickness="1"
                                    CornerRadius="16" Padding="22" Height="90">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                    <Border Width="48" Height="48" CornerRadius="14" Background="#F0ECFF" VerticalAlignment="Center">
                                        <i:Icon Value="fa-solid fa-layer-group" FontSize="20" Foreground="#8067E8" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="7">
                                        <TextBlock Text="合并 PDF" FontSize="16" FontWeight="SemiBold" Foreground="#303347" />
                                        <TextBlock Text="敬请期待" FontSize="11" Foreground="#969BAC" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>

                        <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#EDEEF4" BorderThickness="1"
                                CornerRadius="16" Padding="22" Height="90" Opacity="0.76">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                <Border Width="48" Height="48" CornerRadius="14" Background="#F0F1FF" VerticalAlignment="Center">
                                    <i:Icon Value="fa-solid fa-grip" FontSize="20" Foreground="#7378D9" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="7">
                                    <TextBlock Text="更多工具" FontSize="16" FontWeight="SemiBold" Foreground="#303347" />
                                    <TextBlock Text="敬请期待" FontSize="11" Foreground="#969BAC" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="16" Margin="0,4,0,0">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <TextBlock Text="最近阅读" FontSize="18" FontWeight="SemiBold" Foreground="#272A3C" />
                            <Border Background="#F0F1F7" CornerRadius="9" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RecentDocuments.Count}" FontSize="10" Foreground="#858A9E" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <i:Icon Value="fa-solid fa-grip" FontSize="12" Foreground="#9CA1B2" />
                            <TextBlock Text="网格模式" FontSize="11" Foreground="#969BAC" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="plain-button" Command="{Binding ClearRecentDocumentsCommand}"
                                Padding="8,5" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <i:Icon Value="fa-regular fa-trash-can" FontSize="12" Foreground="#969BAC" />
                                <TextBlock Text="清除所有记录" FontSize="11" Foreground="#8C92A4" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding VisibleRecentDocuments}" ItemTemplate="{StaticResource DocumentCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Border Background="#F7F7FB" CornerRadius="16" Padding="28"
                            IsVisible="{Binding HasNoVisibleRecentDocuments}">
                        <TextBlock Text="{Binding RecentEmptyMessage}" Foreground="#9297A8" HorizontalAlignment="Center" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="20" IsVisible="{Binding IsFavoritesSelected}">
                <StackPanel Spacing="8">
                    <TextBlock Text="我的收藏" FontSize="26" FontWeight="SemiBold" Foreground="#272A3C" />
                    <TextBlock Text="收藏的 PDF 会保存在这里，方便随时继续阅读。" FontSize="13" Foreground="#9297A8" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding FavoriteDocuments}" ItemTemplate="{StaticResource DocumentCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Border Background="#F7F7FB" CornerRadius="16" Padding="36"
                        IsVisible="{Binding HasNoFavoriteDocuments}">
                    <TextBlock Text="还没有收藏文档，可在阅读页工具栏点击星标进行收藏。"
                               Foreground="#9297A8" HorizontalAlignment="Center" />
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
