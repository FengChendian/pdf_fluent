<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:pdf_fluent.ViewModels"
        xmlns:views="using:pdf_fluent.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="pdf_fluent.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Fluent PDF"
        Width="1380" Height="860"
        MinWidth="1040" MinHeight="700"
        Background="#E9EEF5"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ControlTheme x:Key="MoreActionsMenuPresenterTheme" TargetType="MenuFlyoutPresenter"
                      BasedOn="{StaticResource {x:Type MenuFlyoutPresenter}}">
            <Setter Property="MinWidth" Value="172" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E4E7EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </ControlTheme>
        <ControlTheme x:Key="MoreActionsMenuItemTheme" TargetType="MenuItem"
                      BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#51596D" />
            <Setter Property="FontSize" Value="12" />
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="#F0F3F9" />
                <Setter Property="Foreground" Value="#424758" />
            </Style>
            <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
                <Setter Property="Background" Value="#F0F3F9" />
            </Style>
        </ControlTheme>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="Button.plain-button">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.plain-button:pointerover">
            <Setter Property="Background" Value="#F0F3F9" />
        </Style>
        <Style Selector="Button.nav-button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#858CA0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.nav-home">
            <Setter Property="Background" Value="#ECEFFC" />
            <Setter Property="Foreground" Value="#6171D8" />
        </Style>
        <Style Selector="Button.nav-button:pointerover">
            <Setter Property="Background" Value="#F0F3F9" />
            <Setter Property="Foreground" Value="#5F6FD6" />
        </Style>
        <Style Selector="Button.more-actions-button">
            <Setter Property="Background" Value="#F8F9FB" />
        </Style>
        <Style Selector="Button.more-actions-button:pointerover">
            <Setter Property="Background" Value="#F0F3F9" />
        </Style>
        <Style Selector="Button.tab-select">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.tab-select:pointerover">
            <Setter Property="Background" Value="#F0F3F9" />
        </Style>
        <Style Selector="Button.tab-close">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#9CA1B0" />
        </Style>
        <Style Selector="Button.tab-close:pointerover">
            <Setter Property="Background" Value="#F0F3F9" />
            <Setter Property="Foreground" Value="#555D73" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F0F3F9" />
        </Style>
    </Window.Styles>

    <Border Margin="0" CornerRadius="0" Background="#FFFFFF"
            BorderThickness="0">
        <Grid ColumnDefinitions="64,*" RowDefinitions="60,*">
            <Border Grid.RowSpan="2" Background="#F8F9FC" BorderBrush="#E8EBF2" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*" Margin="0,12">
                    <Border Width="36" Height="36" CornerRadius="12" Margin="0,2,0,0"
                            HorizontalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#7586ED" Offset="0" />
                                <GradientStop Color="#5364CE" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="P" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Row="1" Spacing="10" Margin="0,28,0,0"
                                HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Button Classes="nav-button nav-home" Command="{Binding ShowHomeCommand}"
                                ToolTip.Tip="主页">
                            <PathIcon Width="18" Height="18"
                                      Data="M3,11 L12,3 L21,11 L19,11 L19,21 L14,21 L14,15 L10,15 L10,21 L5,21 L5,11 Z" />
                        </Button>
                        <Button Classes="nav-button" Command="{Binding OpenPdfCommand}" ToolTip.Tip="打开新的 PDF">
                            <PathIcon Width="18" Height="18"
                                      Data="M11,4 L13,4 L13,11 L20,11 L20,13 L13,13 L13,20 L11,20 L11,13 L4,13 L4,11 L11,11 Z" />
                        </Button>
                        <Button Classes="nav-button" IsEnabled="False" Opacity="0.48" ToolTip.Tip="星标（即将推出）">
                            <PathIcon Width="19" Height="19"
                                      Data="M12,2 L15,9 L22,9 L16.5,13.5 L18.5,21 L12,16.5 L5.5,21 L7.5,13.5 L2,9 L9,9 Z" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#ECEEF3" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Classes="plain-button" Command="{Binding ShowHomeCommand}" BorderThickness="0"
                            Padding="18,0" Cursor="Hand">
                        <StackPanel Spacing="0" Height="60">
                            <StackPanel Orientation="Horizontal" Spacing="8" Height="57" VerticalAlignment="Center">
                                <PathIcon Width="16" Height="16" Foreground="#6675D7"
                                          Data="M3,11 L12,3 L21,11 L19,11 L19,21 L14,21 L14,15 L10,15 L10,21 L5,21 L5,11 Z" />
                                <TextBlock Text="主页" FontSize="13" FontWeight="Medium" Foreground="#51596D"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Height="3" Width="34" CornerRadius="2" Background="#6879DF"
                                    HorizontalAlignment="Center" IsVisible="{Binding IsHomeSelected}" />
                        </StackPanel>
                    </Button>

                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding OpenDocuments}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:DocumentTabViewModel">
                                    <Border Width="220" Height="44" Margin="5,8,0,8" Padding="0"
                                            Background="#F7F8FB" CornerRadius="10" ClipToBounds="True" x:CompileBindings="False">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,3">
                                            <Button x:Name="TabSelectButton" Classes="tab-select" Grid.RowSpan="2" Grid.ColumnSpan="2"
                                                    Command="{Binding $parent[Window].DataContext.SelectDocumentCommand}"
                                                    CommandParameter="{Binding}"
                                                    BorderThickness="0" Padding="12,0,40,0" Cursor="Hand"
                                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left" VerticalContentAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Background="#E9ECFC" CornerRadius="5" Padding="4,2">
                                                        <TextBlock Text="P" FontSize="9" FontWeight="Bold" Foreground="#6C79D2" />
                                                    </Border>
                                                    <TextBlock Text="{Binding FileName}" FontSize="12" Foreground="#51586B"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="142"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" Grid.RowSpan="2" Classes="tab-close"
                                                    Margin="0,0,7,0" VerticalAlignment="Center"
                                                    Command="{Binding $parent[Window].DataContext.CloseDocumentCommand}"
                                                    CommandParameter="{Binding}" ToolTip.Tip="关闭">
                                                <Path Width="10" Height="10" Stretch="Uniform"
                                                      Stroke="#8B92A3" StrokeThickness="1.5"
                                                      Data="M1,1 L9,9 M9,1 L1,9" />
                                            </Button>
                                            <Border Grid.Row="1" Grid.ColumnSpan="2" Height="3" Width="46"
                                                    CornerRadius="2" Background="#6879DF" HorizontalAlignment="Center"
                                                    IsVisible="{Binding IsSelected}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,18,0" Spacing="8">
                        <ProgressBar Width="64" Height="4" IsIndeterminate="True"
                                     IsVisible="{Binding IsOpening}" Foreground="#6C7BDD" />
                        <Button x:Name="MoreActionsButton" Classes="more-actions-button" Width="32" Height="32" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                CornerRadius="10" BorderThickness="0"
                                Cursor="Hand" ToolTip.Tip="更多操作">
                            <PathIcon Width="16" Height="16" Foreground="#9298A8"
                                      Data="M4,10 A2,2 0 1,0 4,14 A2,2 0 1,0 4,10 M10,10 A2,2 0 1,0 10,14 A2,2 0 1,0 10,10 M16,10 A2,2 0 1,0 16,14 A2,2 0 1,0 16,10" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight"
                                            FlyoutPresenterTheme="{StaticResource MoreActionsMenuPresenterTheme}"
                                            ItemContainerTheme="{StaticResource MoreActionsMenuItemTheme}">
                                    <MenuItem Header="打开新文件" Command="{Binding OpenPdfCommand}" />
                                    <MenuItem Header="关闭所有标签页" Command="{Binding CloseAllDocumentsCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Grid.Column="1">
                <views:HomeView IsVisible="{Binding IsHomeSelected}" />
                <ContentControl Content="{Binding SelectedDocument}" IsVisible="{Binding IsDocumentOpen}">
                    <ContentControl.DataTemplates>
                        <DataTemplate DataType="vm:DocumentTabViewModel">
                            <views:PdfDocumentView />
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
            </Grid>

            <Border Grid.Row="1" Grid.Column="1" Background="#CCFFFFFF" CornerRadius="12"
                    Padding="14,9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,18"
                    IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#666E82" />
            </Border>
        </Grid>
    </Border>
</Window>
