<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:pdf_fluent.ViewModels"
        xmlns:views="using:pdf_fluent.Views"
        xmlns:controls="using:pdf_fluent.Controls"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="pdf_fluent.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/logo.ico"
        Title="Fluent PDF"
        Width="1380" Height="860"
        MinWidth="1040" MinHeight="700"
        Background="#FFFFFF"
        WindowDecorations="Full"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <LinearGradientBrush x:Key="PdfIconGradientBrush" StartPoint="0%,100%" EndPoint="100%,0%">
            <GradientStop Color="#835EF6" Offset="0" />
            <GradientStop Color="#566BF5" Offset="1" />
        </LinearGradientBrush>
        <ControlTheme x:Key="MoreActionsMenuPresenterTheme" TargetType="MenuFlyoutPresenter"
                      BasedOn="{StaticResource {x:Type MenuFlyoutPresenter}}">
            <Setter Property="MinWidth" Value="172" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E4E7EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </ControlTheme>
        <ControlTheme x:Key="MoreActionsMenuItemTheme" TargetType="MenuItem"
                      BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#51596D" />
            <Setter Property="FontSize" Value="12" />
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="#F0F3F9" />
                <Setter Property="Foreground" Value="#424758" />
            </Style>
            <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
                <Setter Property="Background" Value="#F0F3F9" />
            </Style>
        </ControlTheme>
    </Window.Resources>
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SelectedDocument.SaveHighlightsCommand}" />
    </Window.KeyBindings>
    <Window.Styles>
        <Style Selector="Button.plain-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.plain-button:pointerover">
            <Setter Property="Background" Value="#F0F3F9" />
        </Style>
        <Style Selector="Button.nav-button, ToggleButton.nav-button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#7D8499" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.nav-button:pointerover, ToggleButton.nav-button:pointerover">
            <Setter Property="Background" Value="#F0F2F8" />
            <Setter Property="Foreground" Value="#625BE7" />
        </Style>
        <Style Selector="Button.nav-button:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C4C8D2" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="ToggleButton.nav-button.selected, ToggleButton.nav-button.selected:pointerover">
            <Setter Property="Background" Value="#ECEEFF" />
            <Setter Property="Foreground" Value="#625BE7" />
        </Style>
        <Style Selector="Button.more-actions-button">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.more-actions-button:pointerover">
            <Setter Property="Background" Value="#F0F3F9" />
        </Style>
        <Style Selector="ToggleButton.top-tab">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#F0F2F8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Foreground" Value="#777E91" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.top-tab:pointerover">
            <Setter Property="Background" Value="#E4E7F0" />
        </Style>
        <Style Selector="ToggleButton.top-tab.selected">
            <Setter Property="Background" Value="#F0F1FF" />
            <Setter Property="Foreground" Value="#625BE7" />
        </Style>
        <Style Selector="ToggleButton.tab-select">
            <Setter Property="Background" Value="#F0F2F8" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.tab-select:checked">
            <Setter Property="Background" Value="#F0F1FF" />
        </Style>
        <Style Selector="ToggleButton.tab-select:pointerover">
            <Setter Property="Background" Value="#E4E7F0" />
        </Style>
        <Style Selector="Button.tab-close">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#9CA1B0" />
        </Style>
        <Style Selector="Button.tab-close:pointerover">
            <Setter Property="Background" Value="#E9EBF2" />
            <Setter Property="Foreground" Value="#555D73" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F0F3F9" />
        </Style>
        <Style Selector="ToggleButton.top-tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E4E7F0" />
        </Style>
        <Style Selector="Button.nav-button:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.nav-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F0F2F8" />
        </Style>
        <Style Selector="Button.nav-button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.tab-close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E9EBF2" />
        </Style>
        <Style Selector="ToggleButton.nav-button.selected /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.nav-button.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#ECEEFF" />
            <Setter Property="Foreground" Value="#625BE7" />
        </Style>
        <Style Selector="ToggleButton.top-tab.selected /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.top-tab.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F0F1FF" />
            <Setter Property="Foreground" Value="#625BE7" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="72,*" RowDefinitions="56,*">
        <Border x:Name="Sidebar" Grid.Row="0" Grid.RowSpan="2" Background="#F6F7FC" BorderBrush="#F0F1F5" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto" Margin="0,12,0,18">
                <Border x:Name="SidebarAppIcon" Width="40" Height="40" CornerRadius="13" HorizontalAlignment="Center"
                        Background="{StaticResource PdfIconGradientBrush}">
                    <TextBlock Text="P" FontSize="21" FontWeight="Bold" Foreground="#FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Row="1" Spacing="12" Margin="0,30,0,0" HorizontalAlignment="Stretch">
                    <Grid Height="44">
                        <Border x:Name="HomeSelectionIndicator" Width="3" Height="22" CornerRadius="1.5"
                                Background="#6C5CE7" HorizontalAlignment="Left" Margin="6.5,0,6.5,0"
                                VerticalAlignment="Center" IsVisible="{Binding IsHomeSelected}" />
                        <ToggleButton x:Name="HomeNavButton" Classes="nav-button" Classes.selected="{Binding IsHomeSelected}"
                                      Command="{Binding ShowHomeCommand}"
                                      IsChecked="{Binding IsHomeSelected, Mode=OneWay}" ToolTip.Tip="主页">
                            <i:Icon Value="fa-solid fa-house" FontSize="16"
                                    Foreground="{Binding $parent[ToggleButton].Foreground}" />
                        </ToggleButton>
                    </Grid>
                    <Button Classes="nav-button" Command="{Binding OpenPdfCommand}" ToolTip.Tip="打开新的 PDF">
                        <i:Icon Value="fa-solid fa-plus" FontSize="16" />
                    </Button>
                    <Grid Height="44">
                        <Border Width="3" Height="22" CornerRadius="1.5" Background="#6C5CE7"
                                HorizontalAlignment="Left" Margin="6.5,0,6.5,0" VerticalAlignment="Center"
                                IsVisible="{Binding IsFavoritesSelected}" />
                        <ToggleButton x:Name="FavoritesNavButton" Classes="nav-button" Classes.selected="{Binding IsFavoritesSelected}"
                                      Command="{Binding ShowFavoritesCommand}"
                                      IsChecked="{Binding IsFavoritesSelected, Mode=OneWay}" ToolTip.Tip="收藏">
                            <Grid>
                                <i:Icon x:Name="FavoriteNavIcon" Value="fa-regular fa-star" FontSize="16"
                                        Foreground="{Binding $parent[ToggleButton].Foreground}" />
                                <Border x:Name="FavoriteNotificationDot" Width="7" Height="7" CornerRadius="3.5"
                                        Background="#7665E8" BorderBrush="#F6F7FC" BorderThickness="1.5"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,2,0"
                                        IsVisible="{Binding HasFavoriteNotification}" />
                            </Grid>
                        </ToggleButton>
                    </Grid>
                    <Border Width="24" Height="1" Background="#ECEEF3" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>

                <Button Grid.Row="2" Classes="nav-button" IsEnabled="False" ToolTip.Tip="设置（即将推出）">
                    <i:Icon Value="fa-solid fa-gear" FontSize="16"
                            Foreground="{Binding $parent[Button].Foreground}" />
                </Button>
            </Grid>
        </Border>

        <Border x:Name="TopBar" Grid.Row="0" Grid.Column="1" Background="#F8FAFE" BorderBrush="#F0F1F5" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="14,0,16,0">
                <ToggleButton x:Name="HomeTopTab" Classes="top-tab" Classes.selected="{Binding IsHomeSelected}"
                              Command="{Binding ShowHomeCommand}"
                              IsChecked="{Binding IsHomeSelected, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <i:Icon Value="fa-solid fa-house" FontSize="13"
                                Foreground="{Binding $parent[ToggleButton].Foreground}" />
                        <TextBlock Text="主页" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <Button Grid.Column="1" Classes="plain-button" Width="34" Height="34" Margin="4,0,4,0"
                        Padding="0" CornerRadius="10" Command="{Binding OpenPdfCommand}" ToolTip.Tip="打开新的 PDF">
                    <i:Icon Value="fa-solid fa-plus" FontSize="13" Foreground="#9197A8" />
                </Button>

                <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding OpenDocuments}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:DocumentTabViewModel">
                                <Border Width="200" Height="36" Margin="4,4,0,4" Background="Transparent"
                                        CornerRadius="10" ClipToBounds="True" x:CompileBindings="False">
                                    <Grid>
                                        <ToggleButton x:Name="TabSelectButton" Classes="tab-select"
                                                      Command="{Binding $parent[Window].DataContext.SelectDocumentCommand}"
                                                      CommandParameter="{Binding}"
                                                      IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                      BorderThickness="0" Padding="12,0,38,0" Cursor="Hand"
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                      HorizontalContentAlignment="Left" VerticalContentAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border x:Name="DocumentTabIcon" Width="22" Height="22"
                                                        Background="{StaticResource PdfIconGradientBrush}" CornerRadius="6">
                                                    <TextBlock Text="P" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{Binding DisplayFileName}" FontSize="12" Foreground="#51586B"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="128"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <Button Classes="tab-close" Margin="0,0,7,0" HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Command="{Binding $parent[Window].DataContext.CloseDocumentCommand}"
                                                CommandParameter="{Binding}" ToolTip.Tip="关闭">
                                            <i:Icon Value="fa-solid fa-xmark" FontSize="11" Foreground="#8B92A3" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Grid.Column="3" Width="340" Margin="14,0,10,0" VerticalAlignment="Center"
                      IsVisible="{Binding IsHomeSelected}">
                    <TextBox x:Name="DocumentSearchBox" Text="{Binding SearchText}" PlaceholderText="搜索文档…"
                             Height="34" Padding="34,0,12,0" FontSize="12" CornerRadius="10"
                             Background="#F5F6FA" BorderThickness="0" VerticalContentAlignment="Center" />
                    <i:Icon Value="fa-solid fa-magnifying-glass" FontSize="13" Foreground="#8E94A7"
                            Margin="12,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" />
                </Grid>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8">
                    <ProgressBar Width="56" Height="4" IsIndeterminate="True"
                                 IsVisible="{Binding IsOpening}" Foreground="#6C5CE7" />
                    <Button x:Name="MoreActionsButton" Classes="more-actions-button" Width="34" Height="34" Padding="0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            CornerRadius="10" BorderThickness="0" Cursor="Hand" ToolTip.Tip="更多操作">
                        <i:Icon Value="fa-solid fa-ellipsis" FontSize="15" Foreground="#7D8496" />
                        <Button.Flyout>
                            <controls:UnselectedMenuFlyout Placement="BottomEdgeAlignedRight"
                                        FlyoutPresenterTheme="{StaticResource MoreActionsMenuPresenterTheme}"
                                        ItemContainerTheme="{StaticResource MoreActionsMenuItemTheme}">
                                <MenuItem Header="打开新文件" Command="{Binding OpenPdfCommand}" />
                                <MenuItem Header="关闭所有标签页" Command="{Binding CloseAllDocumentsCommand}" />
                            </controls:UnselectedMenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1">
            <views:HomeView IsVisible="{Binding IsLibraryOpen}" />
            <ContentControl Content="{Binding SelectedDocument}" IsVisible="{Binding IsDocumentOpen}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="vm:DocumentTabViewModel">
                        <views:PdfDocumentView />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </Grid>

        <Border Grid.Row="1" Grid.Column="1" Background="#F0FFFFFF" CornerRadius="12"
                Padding="14,9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,18"
                IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#666E82" />
        </Border>
    </Grid>
</Window>
